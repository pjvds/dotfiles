{
  "mcpServers": {
    "aspire": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    },
    "devops": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.dev.azure.com/dttnl-tax-ita"
    },
    "azure": {
      "tools": [
        "*"
      ],
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "playwright": {
      "tools": [
        "*"
      ],
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--executable-path",
        "/etc/profiles/per-user/pvandesande/bin/google-chrome"
      ]
    },
    "azure-devops-dttnl-tax-ita": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.dev.azure.com/dttnl-tax-ita"
    },
    "datadog": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://mcp.datadoghq.eu/v1/mcp"
    },
    "moneybird": {
      "tools": [
        "*"
      ],
      "type": "http",
      "url": "https://moneybird.com/mcp/v1/read_only"
    }
  }
}
